extends ../layout

block content
  .auth-wrapper
    .auth-card
      h2 Login
      hr
      if error
        .error-message= error
      form(action="/login" method="POST")
        .form-group
          label(for="email") Email
          input#email(type="email" name="email" placeholder="your@email.com" required)
        .form-group
          label(for="password") Password
          input#password(type="password" name="password" placeholder="••••••••" required)
        button(type="submit").btn-dark.full-width Login
        p.forgot Forgot password?
    p.auth-switch Don't have an account? #[a(href="/register") Register here] .
